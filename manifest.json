{
  "manifest_version": 3,
  "name": "Blip Block Locker",
  "version": "1.1.0",
  "description": "Trava blocos no canvas do BLiP Builder e mostra guias de alinhamento ao arrastar.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "blip-block-locker@telek.com.br",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Blip Block Locker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.blip.ai/*"
      ],
      "js": [
        "content.js",
        "align.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
